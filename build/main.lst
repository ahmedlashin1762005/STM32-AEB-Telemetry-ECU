  50:Core/Src/main.c **** int main(void) {
  51:Core/Src/main.c ****     HAL_Init();
  52:Core/Src/main.c ****     SystemClock_Config();
  53:Core/Src/main.c **** 
  54:Core/Src/main.c ****     MX_GPIO_Init();
  55:Core/Src/main.c ****     MX_DMA_Init();
  56:Core/Src/main.c ****     MX_USART2_UART_Init();
  57:Core/Src/main.c ****     MX_TIM1_Init();
  58:Core/Src/main.c ****     MX_TIM2_Init();
  59:Core/Src/main.c **** 
  60:Core/Src/main.c ****     Ultrasonic_Init(&htim1);
  61:Core/Src/main.c ****     Motor_Init(&htim2, TIM_CHANNEL_2);
  62:Core/Src/main.c ****     LCD_Init();
  63:Core/Src/main.c ****     Telemetry_Init(&huart2);
  64:Core/Src/main.c **** 
  65:Core/Src/main.c ****     LCD_SetCursor(0, 0);
  66:Core/Src/main.c ****     LCD_SendString("AEB System Ready");
  67:Core/Src/main.c ****     HAL_Delay(1000);
  68:Core/Src/main.c ****     LCD_Clear();
  69:Core/Src/main.c **** 
  70:Core/Src/main.c ****     uint32_t last_us_scan_time = 0;
  71:Core/Src/main.c ****     uint32_t last_telemetry_time = 0;
  72:Core/Src/main.c ****     uint16_t current_pwm = 0;
  73:Core/Src/main.c **** 
  74:Core/Src/main.c ****     while (1) {
  75:Core/Src/main.c ****         uint32_t current_time = HAL_GetTick();
  76:Core/Src/main.c **** 
  77:Core/Src/main.c ****         if (current_time - last_us_scan_time >= 50) {
  78:Core/Src/main.c ****             last_us_scan_time = current_time;
  79:Core/Src/main.c ****             distance_cm = Ultrasonic_Read_Distance();
  80:Core/Src/main.c **** 
  81:Core/Src/main.c ****             if (ir_emergency_flag == 0) {
  82:Core/Src/main.c ****                 if (distance_cm <= 3) {
  83:Core/Src/main.c ****                     current_state = STATE_EMERGENCY;
  84:Core/Src/main.c ****                 } else if (distance_cm <= 20) {
  85:Core/Src/main.c ****                     current_state = STATE_WARNING;
  86:Core/Src/main.c ****                 } else {
  87:Core/Src/main.c ****                     current_state = STATE_NORMAL;
  88:Core/Src/main.c ****                 }
ARM GAS  C:\Users\ADMINI~1\AppData\Local\Temp\cc4jkV0f.s 			page 3


  89:Core/Src/main.c ****             } else {
  90:Core/Src/main.c ****                 if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_8) == GPIO_PIN_SET && distance_cm > 5) {
  91:Core/Src/main.c ****                     ir_emergency_flag = 0;
  92:Core/Src/main.c ****                 }
  93:Core/Src/main.c ****             }
  94:Core/Src/main.c ****         }
  95:Core/Src/main.c **** 
  96:Core/Src/main.c ****         switch (current_state) {
  97:Core/Src/main.c ****             case STATE_NORMAL:
  98:Core/Src/main.c ****                 current_pwm = 1000;
  99:Core/Src/main.c ****                 Motor_SetSpeedAndDir(current_pwm, MOTOR_DIR_FORWARD);
 100:Core/Src/main.c ****                 LED_Off(LED_WARNING);
 101:Core/Src/main.c ****                 LED_Off(LED_EMERGENCY);
 102:Core/Src/main.c ****                 break;
 103:Core/Src/main.c **** 
 104:Core/Src/main.c ****             case STATE_WARNING:
 105:Core/Src/main.c ****                 current_pwm = 500;
 106:Core/Src/main.c ****                 Motor_SetSpeedAndDir(current_pwm, MOTOR_DIR_FORWARD);
 107:Core/Src/main.c ****                 LED_On(LED_WARNING);
 108:Core/Src/main.c ****                 LED_Off(LED_EMERGENCY);
 109:Core/Src/main.c ****                 break;
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****             case STATE_EMERGENCY:
 112:Core/Src/main.c ****                 current_pwm = 0;
 113:Core/Src/main.c ****                 Motor_SetSpeedAndDir(current_pwm, MOTOR_DIR_STOP);
 114:Core/Src/main.c ****                 LED_Off(LED_WARNING);
 115:Core/Src/main.c ****                 LED_On(LED_EMERGENCY);
 116:Core/Src/main.c ****                 break;
 117:Core/Src/main.c ****         }
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****         if (current_time - last_telemetry_time >= 500) {
 120:Core/Src/main.c ****             last_telemetry_time = current_time;
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****             LCD_SetCursor(0, 0);
 123:Core/Src/main.c ****             if (current_state == STATE_NORMAL) LCD_SendString("ST: NORMAL      ");
 124:Core/Src/main.c ****             else if (current_state == STATE_WARNING) LCD_SendString("ST: WARNING     ");
 125:Core/Src/main.c ****             else LCD_SendString("ST: EMERGENCY   ");
 126:Core/Src/main.c **** 
 127:Core/Src/main.c ****             LCD_SetCursor(1, 0);
 128:Core/Src/main.c ****             LCD_SendString("Dist: ");
 129:Core/Src/main.c ****             LCD_PrintNumber(distance_cm);
 130:Core/Src/main.c ****             LCD_SendString(" cm    ");
 131:Core/Src/main.c **** 
 132:Core/Src/main.c ****             Telemetry_SendSystemState(current_state, distance_cm, current_pwm);
 133:Core/Src/main.c ****         }
 134:Core/Src/main.c ****     }
 135:Core/Src/main.c **** }
 136:Core/Src/main.c **** 
 137:Core/Src/main.c **** void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
 138:Core/Src/main.c ****     if (GPIO_Pin == GPIO_PIN_8) {
 139:Core/Src/main.c ****         ir_emergency_flag = 1;
 140:Core/Src/main.c ****         current_state = STATE_EMERGENCY;
 141:Core/Src/main.c ****         Motor_SetSpeedAndDir(0, MOTOR_DIR_STOP);
 142:Core/Src/main.c ****         LED_On(LED_EMERGENCY);
 143:Core/Src/main.c ****         LED_Off(LED_WARNING);
 144:Core/Src/main.c ****     }
 145:Core/Src/main.c **** }
