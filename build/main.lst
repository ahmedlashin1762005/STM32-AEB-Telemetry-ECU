  32:Core/Src/main.c **** typedef enum {
  33:Core/Src/main.c ****     STATE_NORMAL = 0,
  34:Core/Src/main.c ****     STATE_WARNING,
  35:Core/Src/main.c ****     STATE_EMERGENCY
  36:Core/Src/main.c **** } ECU_State_t;
  37:Core/Src/main.c **** 
  38:Core/Src/main.c **** volatile ECU_State_t current_state = STATE_NORMAL;
  39:Core/Src/main.c **** volatile uint8_t ir_emergency_flag = 0;
  40:Core/Src/main.c **** uint32_t distance_cm = 0;
