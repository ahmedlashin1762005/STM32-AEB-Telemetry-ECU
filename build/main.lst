   2:Core/Src/main.c **** /**
   3:Core/Src/main.c ****   ******************************************************************************
   4:Core/Src/main.c ****   * @file           : main.c
   5:Core/Src/main.c ****   * @brief          : Bare-Metal AEB (Autonomous Emergency Braking) & 
   6:Core/Src/main.c ****   *                   Telemetry ECU Engine for STM32F401RE.
   7:Core/Src/main.c ****   * @author         : Ahmed Lashin
   8:Core/Src/main.c ****   * @date           : October 2026
   9:Core/Src/main.c ****   * @description    : Autonomous Emergency Braking system featuring Non-Blocking 
  10:Core/Src/main.c ****   *                   Architecture, IR EXTI zero-latency interrupts, Timer Input 
  11:Core/Src/main.c ****   *                   Capture, Motor Control via Optocoupler, I2C/4-Bit LCD, 
  12:Core/Src/main.c ****   *                   and UART Telemetry via DMA.
  13:Core/Src/main.c ****   ******************************************************************************
  14:Core/Src/main.c ****   */
